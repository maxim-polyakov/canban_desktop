# Скопируйте в .env и подставьте свои значения.
# Переменные из .env переопределяют appsettings.json.

# Entity Framework Core + PostgreSQL (в .NET для вложенных ключей используется __)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=password;

# JWT (ключ не короче 32 символов)
Jwt__Key=YourSuperSecretKeyForJwtSigningAtLeast32Characters!
Jwt__Issuer=CanbanServer
Jwt__Audience=CanbanClient
Jwt__ExpirationMinutes=60

# S3-совместимое хранилище для аватаров (опционально; если не задано, загрузка аватаров отключена)
# S3__Bucket=my-bucket
# S3__Region=us-east-1
# AWS__AccessKeyId=...
# AWS__SecretAccessKey=...
# Для MinIO или другого S3-совместимого: S3__ServiceUrl=http://localhost:9000
# Публичный URL файлов (если не задан, строится как https://{bucket}.s3.{region}.amazonaws.com/{key}): S3__PublicBaseUrl=http://localhost:9000/my-bucket
